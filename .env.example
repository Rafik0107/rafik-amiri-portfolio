# Public URL of the deployed site (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://rafik-amiri-portfolio.vercel.app
# Optional: Google Search Console HTML-tag verification code
NEXT_PUBLIC_GSC_VERIFICATION=

# --- RAIDEN AI (optional). Without a key, a free local answer engine is used. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Private admin dashboard (disabled unless both are set) ---
ADMIN_PASSWORD=
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
ADMIN_SESSION_SECRET=

# --- Admin publishing: commits content changes to GitHub, which triggers a Vercel redeploy ---
# Fine-grained token with "Contents: read & write" on this repository only
GITHUB_TOKEN=
GITHUB_REPO=Rafik0107/rafik-amiri-portfolio
GITHUB_BRANCH=main
